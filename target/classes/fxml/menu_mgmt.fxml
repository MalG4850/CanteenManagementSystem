<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="canteen.MenuManagementController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="700" prefHeight="500">

    <top>
        <VBox spacing="10" padding="15">
            <Label text="Manage Menu" styleClass="dialog-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Add Item" onAction="#handleAddItem" styleClass="primary-button"/>
                <Button text="Add Category" onAction="#handleAddCategory" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="menuTable" VBox.vgrow="ALWAYS" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
            <columns>
                <TableColumn fx:id="colItem" text="Item" prefWidth="200" minWidth="120"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="150" minWidth="100"/>
                <TableColumn fx:id="colPrice" text="Price" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colAvailable" text="Available" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colActions" text="" prefWidth="100" minWidth="80"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" padding="10" spacing="10">
            <Button text="Close" onAction="#closeDialog" cancelButton="true" maxWidth="Infinity"/>
        </HBox>
    </bottom>
</BorderPane>