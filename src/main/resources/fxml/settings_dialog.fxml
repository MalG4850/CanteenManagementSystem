<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="canteen.SettingsController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="400" prefHeight="300">

    <top>
        <Label text="Settings" styleClass="dialog-title" BorderPane.alignment="CENTER" padding="15"/>
    </top>

    <center>
        <VBox spacing="20" padding="20" alignment="CENTER">
            <CheckBox fx:id="darkModeCheck" text="Dark Mode" selected="false"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" padding="10" spacing="10">
            <Button text="Close" onAction="#closeDialog" cancelButton="true" maxWidth="Infinity"/>
        </HBox>
    </bottom>
</BorderPane>